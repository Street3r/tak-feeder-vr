# ---------------------------------------------------------------- TAK server
# 8090 = TLS input that is not stored in the TAK database.
COT_URL=ssl://takserver:8090
# Client certificate and unencrypted key (PEM). The certificate CN must be an
# LDAP user in the group the feeder writes to (e.g. feeder-vr -> VR_WRITE).
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
# Skip TAK server certificate verification (1) or verify against a CA file.
PYTAK_TLS_DONT_VERIFY=1
#PYTAK_TLS_CLIENT_CAFILE=/data/ca.pem

# ---------------------------------------------------------------- Digitraffic
# Sent as the Digitraffic-User header. No personal data (names, e-mail).
DIGITRAFFIC_USER=Street3r/tak-feeder-vr
#DIGITRAFFIC_MQTT_URL=wss://rata.digitraffic.fi:443/mqtt
#DIGITRAFFIC_API_URL=https://rata.digitraffic.fi/api/v1

# ---------------------------------------------------------------- Output
# Seconds between sends of a moving train (min 1, old name UPDATE_INTERVAL)
# and of a stopped one (min 30, old name REFRESH_INTERVAL). The latest
# position is re-sent at this rate even when the source has nothing new.
#SEND_MOVING_INTERVAL=5
#SEND_STATIONARY_INTERVAL=60
# Below this speed (m/s) a train counts as stopped
#STATIONARY_SPEED=0.5
# Marker lifetime in ATAK (s); always at least 3 send intervals
#STALE_SECONDS=180
# Stop sending a train when its last GPS fix is older than this.
#MAX_POSITION_AGE=180
# Generic vehicle, same as tak-feeder-hsl. ATAK has no civilian train symbol.
#COT_TYPE=a-f-G-E-V-C-M
#UID_PREFIX=VR
# First hashtag in the remarks.
#FEED_TAG=vr
# Operator abbreviations in callsigns, by Digitraffic operator code. Codes not
# listed are upper-cased (vr -> VR, destia -> DESTIA). Setting this replaces
# the default list; empty = no abbreviations.
#OPERATOR_CALLSIGNS=ferfi=FENNIARAIL,winco=GRK,vr-track=NRC,operail=NORTHRAIL
# Commuter lines named after the authority that runs them, as tak-feeder-hsl
# ("HSL I") and tak-feeder-nysse ("NYSSE M") name them; also adds #hsl/#nysse.
# Lines not listed (R, Z, D, T, G, O, H) use the operator: "VR R".
# Empty value = no authority names.
#COMMUTER_BRANDS=A=HSL,E=HSL,I=HSL,K=HSL,L=HSL,P=HSL,U=HSL,X=HSL,Y=HSL,M=NYSSE
# Only send these Digitraffic train categories (empty = all):
# Long-distance, Commuter, Cargo, Locomotive, Shunting, On-track machines,
# Test drive, Empty stock (line V / type HV: depot trains without passengers)
#CATEGORIES=
#SOURCE_LINE=Source: Fintraffic / digitraffic.fi, CC BY 4.0
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- HSL overlap
# Commuter trains in the Helsinki region are also published by HSL. Keep this
# off when tak-feeder-hsl does not send trains (docker-tak-feeder-compose:
# HSL_EXCLUDE_MODES=train). If an HSL feeder does send them, the feeder can
# listen to HSL's train feed and pair trains by line, position and heading:
#   uid  = send the train with the same UID as tak-feeder-hsl (one marker)
#   skip = do not send trains HSL already shows
#   off  = ignore HSL, always use VR-<date>-<number>
HSL_MODE=off
#HSL_MQTT_BROKER=mqtt.hsl.fi
#HSL_MQTT_PORT=1883
# Max distance (m) between the two positions of the same train.
#HSL_MATCH_DISTANCE=1500
# HSL positions older than this (s) are not used for pairing.
#HSL_MAX_AGE=60

# ---------------------------------------------------------------- Health
# Unhealthy when no Digitraffic MQTT data has arrived for this long (s, 0 = off)
#HEALTH_MAX_SILENCE=600
#DEBUG=0
