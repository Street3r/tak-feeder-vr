# ---------------------------------------------------------------- TAK server
# 8090 = TLS input that is not stored in the TAK database.
COT_URL=ssl://takserver:8090
# Client certificate and unencrypted key (PEM). The certificate CN must be an
# LDAP user in the group the feeder writes to (e.g. feeder-vr -> VR_WRITE).
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
# Skip TAK server certificate verification (1) or verify against a CA file.
PYTAK_TLS_DONT_VERIFY=1
#PYTAK_TLS_CLIENT_CAFILE=/data/ca.pem

# ---------------------------------------------------------------- Digitraffic
# Sent as the Digitraffic-User header. No personal data (names, e-mail).
DIGITRAFFIC_USER=Street3r/tak-feeder-vr
#DIGITRAFFIC_MQTT_URL=wss://rata.digitraffic.fi:443/mqtt
#DIGITRAFFIC_API_URL=https://rata.digitraffic.fi/api/v1

# ---------------------------------------------------------------- Output
# Seconds between send rounds. A train is sent when its GPS position changes,
# or every REFRESH_INTERVAL seconds otherwise.
#UPDATE_INTERVAL=2
#REFRESH_INTERVAL=30
# Marker lifetime in ATAK without new data.
#STALE_SECONDS=120
# Stop sending a train when its last GPS fix is older than this.
#MAX_POSITION_AGE=180
# Generic neutral ground vehicle. ATAK has no civilian train symbol.
#COT_TYPE=a-n-G-E-V-C-M
#UID_PREFIX=VR
# First hashtag in the remarks.
#FEED_TAG=vr
# Operator abbreviations in callsigns: by default the Digitraffic short code in
# upper case (vr -> VR). Override with code=ABBR pairs.
#OPERATOR_CALLSIGNS=fenniarail=FR
# Only send these Digitraffic train categories (empty = all):
# Long-distance, Commuter, Cargo, Locomotive, Shunting, On-track machines, Test drive
#CATEGORIES=
#SOURCE_LINE=Lähde: Fintraffic / digitraffic.fi, CC 4.0 BY
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- HSL overlap
# Commuter trains in the Helsinki region are also published by HSL and sent
# by tak-feeder-hsl. The feeder listens to HSL's train feed and pairs trains
# by line letter, position and heading.
#   uid  = send the train with the same UID as tak-feeder-hsl (one marker)
#   skip = do not send trains HSL already shows
#   off  = ignore HSL, always use VR-<date>-<number>
HSL_MODE=uid
#HSL_MQTT_BROKER=mqtt.hsl.fi
#HSL_MQTT_PORT=1883
# Max distance (m) between the two positions of the same train.
#HSL_MATCH_DISTANCE=1500
# HSL positions older than this (s) are not used for pairing.
#HSL_MAX_AGE=60

#DEBUG=0
